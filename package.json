  "type": "module",
  "main": "index.js",
  "scripts": {
    "start": "vite --open --host --force",
    "start:prod": "vite --open --host --force --mode production",
    "build": "vite build --sourcemap=true",
    "check:old-tvs": "node scripts/check-old-tvs.mjs",
    "build:analyze": "vite-bundle-visualizer",
    "preview": "vite preview --open --port 8080",
    "test": "vitest",
    "tsc": "tsc",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "prepare": "husky",
    "lint": "oxlint",
    "lint-fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check": "oxfmt --check && oxlint --deny-warnings && tsc && vitest run",
    "deploy:tizen": "./scripts/deploy-tizen.sh",
    "test-streams": "node scripts/test-streams/server.mjs",
    "tv-probe": "./scripts/tv-probe/run.sh"
  },
  "dependencies": {
    "@lightningtv/vite-hex-transform": "^1.1.0",
    "@solid-primitives/i18n": "^2.2.1",
    "@solidjs/router": "^0.16.3",
    "@solidtv/renderer": "^2.0.6",
    "@solidtv/solid": "^1.7.0",
    "@storybook/addon-a11y": "^10.6.2",
    "@storybook/addon-docs": "^10.6.2",
    "@storybook/addon-links": "^10.6.2",
    "@storybook/addon-onboarding": "^10.6.2",
    "@storybook/addon-vitest": "^10.6.2",
    "@vitest/coverage-v8": "^5.0.5",
    "fflate": "^0.8.3",
    "lodash-es": "^4.18.1",
    "shaka-player": "^5.3.0",
    "solid-js": "^1.9.17",
    "storybook": "^10.6.2",
    "storybook-solidjs-vite": "^10.7.2"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@chromatic-com/storybook": "^5.5.1",
    "@vitejs/plugin-legacy": "^8.2.3",
    "@vitest/browser": "^5.0.5",
    "@vitest/browser-playwright": "^5.0.5",
    "acorn": "^8.16.0",
    "core-js": "^3.50.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "oxlint-tsgolint": "^7.0.2005",
    "playwright": "^1.64.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-bundle-visualizer": "^1.2.1",
    "vite-plugin-cross-origin-isolation": "^0.1.6",
    "vite-plugin-solid": "^2.11.14",
    "vitest": "^5.0.5"
  },
  "lint-staged": {
    "*": "oxfmt --no-error-on-unmatched-pattern",
    "*.{js,jsx,ts,tsx,mjs,cjs}": "oxlint --fix"
  },
  "packageManager": "pnpm@12.14.0"
}
